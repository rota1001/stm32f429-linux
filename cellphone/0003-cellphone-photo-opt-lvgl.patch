+    lv_draw_image_dsc_t d;
+    lv_draw_image_dsc_init(&d);
+    d.src = path;
+    lv_area_t a = { 0, 0, (int32_t)w - 1, (int32_t)h - 1 };
+    lv_draw_image(&layer, &d, &a);
+    lv_canvas_finish_layer(canvas, &layer);   /* synchronous: buf now holds decoded RGB565 */
+
+    lv_obj_delete(canvas);
+    return true;
