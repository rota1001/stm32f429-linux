+
+/* Release/reclaim DRM master so another process (e.g. a vfork'd DOOM) can
+ * modeset the panel while LVGL is paused, then take the display back. */
+void lv_linux_drm_drop_master(lv_display_t * disp)
+{
+    drm_dev_t * drm_dev = lv_display_get_driver_data(disp);
+    if(drm_dev && drm_dev->fd >= 0) drmDropMaster(drm_dev->fd);
+}
+
+void lv_linux_drm_set_master(lv_display_t * disp)
+{
+    drm_dev_t * drm_dev = lv_display_get_driver_data(disp);
+    if(drm_dev && drm_dev->fd >= 0) drmSetMaster(drm_dev->fd);
+}
+
+/* Free the scanout/draw dumb buffers back to the OS (RmFB + munmap +
+ * DESTROY_DUMB) so a vfork'd DOOM can use that ~2x256KB of SDRAM. The display
+ * object survives; rebuild_buffers() re-creates the buffers when DOOM exits. */
+void lv_linux_drm_release_buffers(lv_display_t * disp)
+{
+    drm_dev_t * drm_dev = disp ? lv_display_get_driver_data(disp) : NULL;
+    if(drm_dev == NULL || drm_dev->fd < 0) return;
+
+    drm_flush_wait(disp);                 /* let any pending page flip finish */
+
+    for(int i = 0; i < BUFFER_CNT; i++) {
+        drm_buffer_t * b = &drm_dev->drm_bufs[i];
+        if(b->fb_handle) {
+            drmModeRmFB(drm_dev->fd, b->fb_handle);
+            b->fb_handle = 0;
+        }
+        if(b->map && b->map != MAP_FAILED) {
+            munmap(b->map, b->size);
+            b->map = NULL;
+        }
+        if(b->handle) {
+            struct drm_mode_destroy_dumb dreq;
+            lv_memzero(&dreq, sizeof(dreq));
+            dreq.handle = b->handle;
+            drmIoctl(drm_dev->fd, DRM_IOCTL_MODE_DESTROY_DUMB, &dreq);
+            b->handle = 0;
+        }
+        b->size = 0;
+        b->pitch = 0;
+        b->offset = 0;
+    }
+    drm_dev->act_buf = NULL;
+}
+
+/* Re-create the dumb buffers freed by release_buffers() and re-point LVGL at
+ * them. needs_modeset is re-armed because DOOM changed the CRTC while it ran.
+ * The caller should invalidate + lv_refr_now() afterwards to repaint. */
+void lv_linux_drm_rebuild_buffers(lv_display_t * disp)
+{
+    drm_dev_t * drm_dev = disp ? lv_display_get_driver_data(disp) : NULL;
+    if(drm_dev == NULL || drm_dev->fd < 0) return;
+
+    if(drm_setup_buffers(drm_dev)) {
+        LV_LOG_ERROR("DRM buffer rebuild failed");
+        return;
+    }
+
+    size_t buf_size = LV_MIN(drm_dev->drm_bufs[1].size, drm_dev->drm_bufs[0].size);
+    uint32_t stride = drm_dev->drm_bufs[0].pitch;
+    lv_display_set_buffers_with_stride(disp, drm_dev->drm_bufs[1].map, drm_dev->drm_bufs[0].map,
+                                       buf_size, stride, LV_DISPLAY_RENDER_MODE_DIRECT);
+
+    drm_dev->act_buf = NULL;
+    drm_dev->needs_modeset = 1;           /* DOOM's setcrtc changed the CRTC */
+}
