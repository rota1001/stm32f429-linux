+/* ---- DOOM app: launch DOOM as a separate process (vfork) that owns the panel ----
+ * The board has no shared memory (no SHMEM/tmpfs), so DOOM can't render into an
+ * LVGL canvas. Instead: pause LVGL, release DRM master, vfork+exec the doom
+ * binary (it modesets and draws the panel itself + reads touch via tslib), wait
+ * for it to exit (tap the reserved [200..239] strip), then reclaim the display. */
+extern void lv_linux_drm_drop_master(lv_display_t * disp);
+extern void lv_linux_drm_set_master(lv_display_t * disp);
+extern void lv_linux_drm_release_buffers(lv_display_t * disp);
+extern void lv_linux_drm_rebuild_buffers(lv_display_t * disp);
+
+static void doom_launch_cb(lv_timer_t * t)
+{
+    lv_display_t * disp = lv_display_get_default();
+
+    lv_linux_drm_drop_master(disp);          /* let DOOM become DRM master */
+    lv_linux_drm_release_buffers(disp);      /* free 2x256KB of SDRAM for DOOM */
+    pid_t pid = vfork();
+    if(pid == 0) {
+        execl("/root/doomdrm-single", "doomdrm-single", "-iwad", "/root/doom1.wad", (char *)NULL);
+        _exit(127);                          /* exec failed */
+    }
+    if(pid > 0) {
+        int status;
+        waitpid(pid, &status, 0);            /* block (LVGL paused) until DOOM exits */
+    }
+    lv_linux_drm_set_master(disp);           /* take the panel back */
+    lv_linux_drm_rebuild_buffers(disp);      /* re-create the display buffers */
+    /* DOOM ran with LVGL blocked in waitpid, but inactivity is measured in real
+     * time -- without this the idle timer would see the whole DOOM session as
+     * "idle" and auto-lock the instant we return. Reset the activity clock. */
+    lv_display_trigger_activity(disp);
+    lv_obj_invalidate(lv_screen_active());
+    lv_refr_now(disp);
+
+    lv_timer_delete(t);
+    cellphone_screen_pop();                  /* back to the home grid */
+}
+
+static lv_obj_t * cellphone_doom_create(lv_obj_t * parent)
+{
+    cellphone_obj_paint_fill(parent, lv_color_black());
+    lv_obj_t * lbl = cellphone_label(parent, "Launching DOOM...",
+                                     CELLPHONE_FONT_NORMAL, lv_color_white());
+    lv_obj_center(lbl);
+
+    /* Launch after this screen has been shown once (so the user sees feedback;
+     * the callback then blocks in waitpid while DOOM owns the display). */
+    lv_timer_t * t = lv_timer_create(doom_launch_cb, 150, NULL);
+    lv_timer_set_repeat_count(t, 1);
+    return parent;
+}
