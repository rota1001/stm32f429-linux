+                   (unsigned long long)g_fill_us, (unsigned long long)g_letter_us,
+                   (unsigned long long)g_blit_us, (unsigned long long)g_dma2d_us, (unsigned long long)g_layout_us,
+                   (unsigned long long)g_vsync_us, (unsigned long long)g_flush_us,
+                   (unsigned long long)(fr - g_io_us - g_decode_us - g_fill_us - g_letter_us
+                                        - g_blit_us - g_dma2d_us - g_layout_us - g_vsync_us - g_flush_us),
+                   (unsigned long long)g_img_cnt, (unsigned long long)g_mcu_cnt,
+                   (unsigned long long)g_dma2d_tasks);
             fflush(stdout);
         }
 #endif
