@@ -111,7 +111,8 @@ static void run_loop_drm(void)
 
 #if LV_DEBUG
     extern uint64_t g_io_us, g_io_bytes, g_decode_us, g_blit_us, g_flush_us, g_mcu_cnt, g_img_cnt;
-    extern uint64_t g_idct_us, g_yuv_us;
+    extern uint64_t g_idct_us, g_yuv_us, g_dma2d_tasks;
+    extern uint64_t g_fill_us, g_letter_us, g_dma2d_us, g_layout_us, g_vsync_us;
     extern uint64_t perf_now_us(void);
     {
         lv_mem_monitor_t m;
@@ -126,24 +127,29 @@ static void run_loop_drm(void)
     while(true) {
 #if LV_DEBUG
         g_io_us = g_io_bytes = g_decode_us = g_blit_us = g_flush_us = g_mcu_cnt = g_img_cnt = 0;
