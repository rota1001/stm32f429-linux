+/*--------------------------------------------------------------------------
+ * Per-page icon cache
+ *------------------------------------------------------------------------*/
+
+/* One page: show_cache=true puts the bitmap up and hides the live icons (used
+ * while scrolling and for off-screen pages); false shows the live icons and
+ * hides the bitmap (the stable, interactive page). No-op (icons stay live) if
+ * the page has no cached bitmap (OOM / not built yet). */
+static void home_page_show_cache(uint32_t page, bool show_cache)
+{
+    if(page >= s_page_count || page >= HOME_MAX_PAGES) return;
+    lv_obj_t * tile = s_tiles[page];
+    lv_obj_t * img = s_cache_img[page];
+    if(!tile || !lv_obj_is_valid(tile)) return;
+    if(show_cache && (!img || !lv_obj_is_valid(img))) return;
+
+    uint32_t n = lv_obj_get_child_count(tile);
+    for(uint32_t i = 0; i < n; i++) {
+        lv_obj_t * child = lv_obj_get_child(tile, i);
+        bool is_cache = (child == img);
+        /* cache image visible while cached; icons are the opposite. */
+        if(is_cache ? show_cache : !show_cache) lv_obj_clear_flag(child, LV_OBJ_FLAG_HIDDEN);
+        else lv_obj_add_flag(child, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+/* Index of the page currently snapped into the viewport. */
+static int32_t home_active_page(void)
+{
+    if(!s_tileview) return 0;
+    lv_obj_t * tile = lv_tileview_get_tile_active(s_tileview);
+    if(!tile) return 0;
+    int32_t tv_w = lv_obj_get_width(s_tileview);
+    if(tv_w <= 0) return 0;
+    return lv_obj_get_x(tile) / tv_w;
+}
+
+/* Snapshot every page's icon grid into an opaque RGB565 bitmap and park an
+ * (initially hidden, non-clickable) image over each tile. The wallpaper is
+ * baked into the tile background, so the snapshot is fully opaque: during a
+ * swipe DMA2D copies it (memory-to-memory + PFC) instead of blending ARGB8888,
+ * which halves SDRAM traffic, skips the background cache-clean, and halves the
+ * cache memory. On OOM a page is skipped and falls back to live rendering. */
+static void home_cache_build(void)
+{
+    for(uint32_t p = 0; p < s_page_count && p < HOME_MAX_PAGES; p++) {
+        if(s_cache_buf[p]) continue;                 /* already cached */
+        lv_obj_t * tile = s_tiles[p];
+        if(!tile || !lv_obj_is_valid(tile)) continue;
+
+        lv_draw_buf_t * buf = lv_snapshot_take(tile, LV_COLOR_FORMAT_RGB565);
+        if(!buf) continue;
+        s_cache_buf[p] = buf;
+
+        lv_obj_t * img = lv_image_create(tile);
+        lv_obj_add_flag(img, LV_OBJ_FLAG_IGNORE_LAYOUT);
+        lv_obj_clear_flag(img, LV_OBJ_FLAG_CLICKABLE);
+        /* The snapshot covers the tile plus its ext-draw margin; align the
+         * image so pixel (0,0) of the bitmap lands on the tile's top-left. */
+        int32_t ext = lv_obj_get_ext_draw_size(tile);
+        lv_obj_set_pos(img, -ext, -ext);
+        lv_image_set_src(img, buf);
+        lv_obj_add_flag(img, LV_OBJ_FLAG_HIDDEN);
+        s_cache_img[p] = img;
+    }
+}
+
+static void home_cache_build_timer_cb(lv_timer_t * t)
+{
+    s_cache_build_timer = NULL;
+    home_cache_build();
+    /* Put every off-screen page on its bitmap so a swipe never has to render
+     * them live; keep the active page live so it stays tappable with its native
+     * pressed background. (Skip while editing -- icons must stay live then.) */
+    if(!s_edit_mode) {
+        int32_t active = home_active_page();
+        for(uint32_t p = 0; p < s_page_count && p < HOME_MAX_PAGES; p++) {
+            home_page_show_cache(p, (int32_t)p != active);
+        }
+        s_live_page = active;
+    }
+    lv_timer_delete(t);
+}
+
+/* Tear the cache down completely: restore the live icons, delete the cache
+ * images and free their draw buffers. Safe to call when the objects have
+ * already been deleted (rebuild path) -- everything is guarded. */
+static void home_cache_free(void)
+{
+    if(s_cache_build_timer) {
+        lv_timer_delete(s_cache_build_timer);
+        s_cache_build_timer = NULL;
+    }
+    if(s_reveal_timer) {
+        lv_timer_delete(s_reveal_timer);
+        s_reveal_timer = NULL;
+    }
+
+    for(uint32_t p = 0; p < HOME_MAX_PAGES; p++) {
+        home_page_show_cache(p, false);   /* bring icons back before deleting */
+        if(s_cache_img[p] && lv_obj_is_valid(s_cache_img[p])) {
+            lv_obj_delete(s_cache_img[p]);
+        }
+        s_cache_img[p] = NULL;
+        if(s_cache_buf[p]) {
+            lv_draw_buf_destroy(s_cache_buf[p]);
+            s_cache_buf[p] = NULL;
+        }
+    }
+    s_live_page = -1;
+}
+
+/* True while any pointer device is pressed (finger still on screen). */
+static bool home_pointer_pressed(void)
+{
+    lv_indev_t * id = lv_indev_get_next(NULL);
+    while(id) {
+        if(lv_indev_get_type(id) == LV_INDEV_TYPE_POINTER &&
+           lv_indev_get_state(id) == LV_INDEV_STATE_PRESSED) {
+            return true;
+        }
+        id = lv_indev_get_next(id);
+    }
+    return false;
+}
+
+/* Fires once the scroll has been quiet for the debounce window. If the finger
+ * is still down (a mid-drag pause) we wait longer; otherwise reveal the settled
+ * page's live icons (a single redraw, while the screen is already stationary). */
+static void home_reveal_timer_cb(lv_timer_t * t)
+{
+    if(s_edit_mode) {
+        lv_timer_delete(t);
+        s_reveal_timer = NULL;
+        return;
+    }
+    if(home_pointer_pressed()) {   /* still touching -> not settled yet */
+        lv_timer_reset(t);
+        return;
+    }
+    int32_t pg = home_active_page();
+    home_page_show_cache((uint32_t)pg, false);
+    s_live_page = pg;
+    lv_timer_delete(t);
+    s_reveal_timer = NULL;
+}
+
+/* Driven by LV_EVENT_SCROLL, which fires on every motion frame of both the drag
+ * and the post-release snap animation. Any motion -> make sure no page shows
+ * live icons (the whole gesture stays on DMA2D-copied bitmaps), and (re)arm the
+ * debounce timer. The timer only fires ~80 ms after motion fully stops, so the
+ * live-icon reveal can never happen mid-scroll. Edit mode keeps icons live. */
+static void home_scroll_cb(lv_event_t * e)
+{
+    LV_UNUSED(e);
+    if(s_edit_mode) return;
+
+    if(s_live_page >= 0) {
+        home_page_show_cache((uint32_t)s_live_page, true);
+        s_live_page = -1;
+    }
+
+    if(s_reveal_timer) {
+        lv_timer_reset(s_reveal_timer);
+    }
+    else {
+        s_reveal_timer = lv_timer_create(home_reveal_timer_cb, 80, NULL);
+    }
+}
+
+static void home_visibility_cb(lv_event_t * e)
+{
+    lv_event_code_t code = lv_event_get_code(e);
+
+    if(code == (lv_event_code_t)cellphone_screen_event_hidden()) {
+        home_cache_free();
+        return;
+    }
+    if(code == (lv_event_code_t)cellphone_screen_event_shown()) {
+        /* Defer the (heavy) snapshot a couple of frames so it lands while the
+         * screen is idle rather than blocking the return-to-home transition. */
+        if(!s_cache_build_timer && !s_cache_buf[0]) {
+            s_cache_build_timer = lv_timer_create(home_cache_build_timer_cb, 60, NULL);
+            lv_timer_set_repeat_count(s_cache_build_timer, 1);
+        }
+    }
+}
+
 #endif /* LV_USE_DEMO_CELLPHONE */
