+/* --- DMA2D-friendly banded vertical gradient (see header) --- */
+typedef struct {
+    lv_color_t top;
+    lv_color_t bot;
+} cellphone_grad_band_t;
+
+static void grad_banded_draw_cb(lv_event_t * e)
+{
+    lv_obj_t * obj = lv_event_get_target(e);
+    lv_layer_t * layer = lv_event_get_layer(e);
+    const cellphone_grad_band_t * g = lv_event_get_user_data(e);
+    if(!g) return;
+
+    lv_area_t coords;
+    lv_obj_get_coords(obj, &coords);
+    int32_t h = lv_area_get_height(&coords);
+    if(h <= 1) return;
+
+    /* Only bands that intersect the current clip (the area being refreshed) need
+     * to be emitted. On a partial redraw -- e.g. dragging the slider, which only
+     * dirties a strip -- this keeps us from queueing all 12 band fills (and a
+     * second set for a second dirty region); we emit just the few that overlap. */
+    const lv_area_t * clip = &layer->_clip_area;
+
+    lv_draw_rect_dsc_t dsc;
+    lv_draw_rect_dsc_init(&dsc);
+    dsc.bg_opa = LV_OPA_COVER;
+    dsc.radius = 0;
+
+    /* Walk the height, quantize each row to RGB565, and emit one solid rect per
+     * run of identical color. Each rect is radius-0 + solid -> DMA2D fill. */
+    int32_t run_start = 0;
+    uint16_t prev565 = 0;
+    bool have_prev = false;
+
+    for(int32_t y = 0; y <= h; y++) {
+        uint16_t cur565 = 0;
+        if(y < h) {
+            int32_t r  = (g->top.red   * (h - 1 - y) + g->bot.red   * y) / (h - 1);
+            int32_t gr = (g->top.green * (h - 1 - y) + g->bot.green * y) / (h - 1);
+            int32_t b  = (g->top.blue  * (h - 1 - y) + g->bot.blue  * y) / (h - 1);
+            cur565 = (uint16_t)(((r & 0xF8) << 8) | ((gr & 0xFC) << 3) | (b >> 3));
+        }
+        if(have_prev && (y == h || cur565 != prev565)) {
+            lv_area_t band;
+            band.x1 = coords.x1;
+            band.x2 = coords.x2;
+            band.y1 = coords.y1 + run_start;
+            band.y2 = coords.y1 + y - 1;
+
+            /* Skip bands entirely outside the refresh clip. */
+            if(band.y1 <= clip->y2 && band.y2 >= clip->y1) {
+                /* Reconstruct canonical 8-bit from the band's RGB565 so the fill
+                 * lands on exactly that 565 value on screen. */
+                uint8_t r8 = (uint8_t)(((prev565 >> 11) & 0x1F) << 3);
+                uint8_t g8 = (uint8_t)(((prev565 >> 5)  & 0x3F) << 2);
+                uint8_t b8 = (uint8_t)((prev565 & 0x1F) << 3);
+                r8 |= r8 >> 5;
+                g8 |= g8 >> 6;
+                b8 |= b8 >> 5;
+                dsc.bg_color = lv_color_make(r8, g8, b8);
+                lv_draw_rect(layer, &dsc, &band);
+            }
+            run_start = y;
+        }
+        prev565 = cur565;
+        have_prev = true;
+    }
+}
+
+static void grad_banded_delete_cb(lv_event_t * e)
+{
+    cellphone_grad_band_t * g = lv_event_get_user_data(e);
+    if(g) lv_free(g);
+}
+
+void cellphone_obj_paint_grad_banded(lv_obj_t * obj, lv_color_t top, lv_color_t bot)
+{
+    cellphone_grad_band_t * g = lv_malloc(sizeof(*g));
+    if(!g) {                       /* OOM -> plain SW gradient still looks right */
+        cellphone_obj_paint_grad(obj, top, bot);
+        return;
+    }
+    g->top = top;
+    g->bot = bot;
+
+    /* Opaque base fill (radius 0, no style gradient) so the object reports
+     * LV_COVER_RES_COVER (lv_obj.c COVER_CHECK requires bg_opa==COVER). A
+     * transparent bg would make every partial redraw -- e.g. a slider drag --
+     * repaint the entire stack *behind* this screen, which is far costlier than
+     * the one extra DMA2D fill the base adds. The bands paint over it. */
+    lv_obj_set_style_bg_color(obj, bot, 0);
+    lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+    lv_obj_set_style_radius(obj, 0, 0);
+    lv_obj_add_event_cb(obj, grad_banded_draw_cb, LV_EVENT_DRAW_MAIN, g);
+    lv_obj_add_event_cb(obj, grad_banded_delete_cb, LV_EVENT_DELETE, g);
+}
+
